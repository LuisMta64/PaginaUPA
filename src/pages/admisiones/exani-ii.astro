---
import CardList from '../../components/CardList.astro';
import Layout from '../../layouts/Layout.astro';

const items = [
  { title: 'Guía EXANI II', description: 'Información para el examen EXANI II.', href: '/docs/exani-ii-guia.pdf' },
  { title: 'Fechas y sedes', description: 'Calendario y sedes disponibles.', href: '/docs/exani-ii-fechas.pdf' }
];
---

<Layout>
  <main class="container mx-auto px-4 md:px-20 py-10">
    <h1 class="text-3xl font-bold mb-4">EXANI II</h1>
    <p class="text-gray-700 mb-6">Todo lo relacionado con EXANI II: guías, fechas y requisitos.</p>

    <CardList items={items} />
  </main>
</Layout>
