---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="container mx-auto px-4 md:px-20 py-10">
    <h1 class="text-3xl font-bold mb-4">Becas</h1>
    <p class="text-gray-700 mb-6">Información sobre tipos de beca, requisitos y procesos de solicitud.</p>

    <section class="grid gap-6 md:grid-cols-2">
      <article class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-xl font-semibold">Becas académicas</h2>
        <p class="text-gray-600">Apoyo para estudiantes con alto desempeño académico.</p>
      </article>
      <article class="bg-white p-6 rounded-lg shadow">
        <h2 class="text-xl font-semibold">Becas económicas</h2>
        <p class="text-gray-600">Apoyo para estudiantes con necesidades económicas.</p>
      </article>
    </section>
  </main>
</Layout>
