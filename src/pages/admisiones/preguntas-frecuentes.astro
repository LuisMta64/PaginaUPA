---
import FAQ from '../../components/FAQ.astro';
import Layout from '../../layouts/Layout.astro';

const items = [
  { question: '¿Cómo me inscribo?', answer: 'Revisa la convocatoria y sigue el proceso descrito en la sección de requisitos.' },
  { question: '¿Cuál es la fecha límite?', answer: 'La fecha límite aparece en la convocatoria oficial; revisa los PDFs enlazados.' },
  { question: '¿Dónde puedo ver resultados?', answer: 'En la sección de resultados de examen encontrarás los PDFs oficiales.' }
];
---

<Layout>
  <main class="container mx-auto px-4 md:px-20 py-10">
    <h1 class="text-3xl font-bold mb-4">Preguntas frecuentes</h1>
    <p class="text-gray-700 mb-6">Respuestas rápidas a las dudas más comunes sobre admisiones.</p>

    <FAQ items={items} />
  </main>
</Layout>
