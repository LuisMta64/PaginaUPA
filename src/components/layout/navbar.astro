<script>
  const menuToggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  menuToggle.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });
</script>

<style>
  /* Estilo personalizado con efecto de gradiente predominantemente azul */
  .dropdown {
    position: absolute;
    left: 0;
    top: 100%;
    display: none;
    background: linear-gradient(135deg, #1a237e, #3949ab, #283593, #1e88e5); /* Tonos azules */
    background-size: 300% 300%;
    color: white;
    min-width: 200px; /* Ancho más elegante */
    border-radius: 12px; /* Bordes más redondeados */
    padding: 10px 0; /* Espaciado interno */
    box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.3); /* Sombra más pronunciada */
    z-index: 100;
    animation: gradient-animation 6s ease infinite; /* Animación más lenta */
  }

  .dropdown-item {
    display: block;
    padding: 12px 20px; /* Espaciado más amplio */
    font-size: 15px; /* Tamaño de fuente más grande */
    font-weight: 600; /* Negrita para mayor formalidad */
    color: white;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.2s ease; /* Suaviza el hover */
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.15); /* Resalta con fondo translúcido */
    color: #e3f2fd; /* Cambia el texto a un azul más claro */
    transform: scale(1.05); /* Efecto de aumento sutil */
  }

  .group:hover .dropdown {
    display: block; /* Muestra el menú al pasar el cursor */
  }

  /* Subpanel que aparece cuando se pasa sobre Conócenos */
  .dropdown .has-sub {
    position: relative;
  }

  .dropdown .subpanel {
    display: none;
    position: absolute;
    left: 100%;
    top: 0;
    min-width: 240px;
    background: linear-gradient(135deg, #152a4b, #1a3a63);
    border-radius: 8px;
    box-shadow: 0 8px 18px rgba(0,0,0,0.25);
    z-index: 200;
  }

  /* Si la subpanel está cerca del borde derecho, abrir hacia la izquierda */
  .dropdown .has-sub.align-left > .subpanel {
    left: auto;
    right: 100%;
  }

  .dropdown .has-sub:hover > .subpanel {
    display: block;
  }

  /* Ajustes visuales para los items dentro del subpanel */
  .dropdown .subpanel .dropdown-item {
    padding: 12px 16px;
    white-space: nowrap;
  }

  /* Animación del gradiente */
  @keyframes gradient-animation {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>
