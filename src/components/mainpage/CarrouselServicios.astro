---
import admision from '../../assets/images/home/admision.jpg'
import becas from '../../assets/images/home/becas.jpg'
import buzon from '../../assets/images/home/buzon.jpg'
import coworking from '../../assets/images/home/coworking.jpg'
import CPIUPA from '../../assets/images/home/CPIUPA.jpg'
import negocios from '../../assets/images/home/negocios.jpg'
import pagos from '../../assets/images/home/pagos.jpg'
import Serviciosocial from '../../assets/images/home/ServicioSocial.jpg'
import transparencia from '../../assets/images/home/transparencia.jpg'

import Card from '../shared/card.astro'

---
  <!-- component -->
<div class="relative w-screen h-[80vh] bg-slate-800 overflow-hidden">
  <input
    class="hidden peer/slider1 checkbox"
    type="radio"
    name="slider"
    id="slider1"
    checked
  />
  <input
    class="hidden peer/slider2 checkbox"
    type="radio"
    name="slider"
    id="slider2"
  />
  <input
    class="hidden peer/slider3 checkbox"
    type="radio"
    name="slider"
    id="slider3"
  />

  <div
    class="relative w-[300vw] h-[100%] flex transition-all duration-500 ease-in-out peer-checked/slider1:-left-0 peer-checked/slider2:-left-[100vw] peer-checked/slider3:-left-[200vw]"
  >
    <div class="relative w-full h-full flex bg-white gap-4 py-9 place-content-center">
      <Card 
        title="Proceso de admisión"
        image={admision.src}
        description="Convocamos a los egresados ​​o estudiantes próximos a egresar del nivel medio superior y que estén interesados ​​en cursar una licenciatura, a registrarse en el proceso de admisión. ¡Únete a la UPA!">
        </Card>
      <Card 
        title="Becas"
        image={becas.src}
        description="Ofrecemos las becas y apoyos a nuestras alumnos y personal académico para continuar con su educación. Conoce los requisitos y procedimientos para solicitarlos.">
        </Card>
      <Card 
        title="Sistema de pagos "
        image={pagos.src}
        description="Los servicios de la Universidad que se pueden pagar a través de una referencia bancaria son: Colegiatura, Reinscripción y Materia Recursada.">
        </Card>
      <Card 
        title="Transparencia "
        image={transparencia.src}
        description="Aquí encontrarás los formatos de Obligaciones Públicas de Transparencia de nuestra Universidad.">
        </Card>
      </div>
      <div class="relative w-full h-full flex bg-white gap-4 py-9 place-content-center">
      <Card 
        title="Buzón "
        image={buzon.src}
        description="Ayúdanos a mejorar continuamente la calidad en el servicio y nuestro desempeño ambiental, dejándonos quejas, sugerencias y felicitaciones.">
        </Card>
      <Card 
        title="Centro de negocios"
        image={negocios.src}
        description="Los alumnos de Negocios y Administración cuentan con un Centro de Negocios como laboratorio para su formación profesional, y pueden terminar su carrera ya con experiencia profesional. ">
        </Card>
      <Card 
        title="Coworking UPA"
        image={coworking.src}
        description="Nuestros espacios de Coworking individuales y compartidos abren las puertas a tus proyectos o empresa a nuevas posibilidades.">
        </Card>
      <Card 
        title="CPIUPA (Centro de Propiedad Intelectual)"
        image={CPIUPA.src}
        description="Brinda asesoría y gestión de protección intelectual, mediante una relación de confianza, siendo conscientes de los derechos de los autores e inventores de la región centro-bajío-occidente.">
        </Card>
      </div>
      <div class="relative w-full h-full flex bg-white gap-4 py-9 place-content-center">
      <Card 
        title="Servicio Social Comunitario"
        image={Serviciosocial.src}
        description="Revisa las convocatorias y regístrate, ya que es un requisito de titulación.">
        </Card>
    </div>
  </div>

  <div
    class="absolute w-full flex justify-center gap-2 bottom-12 peer-[&_label:nth-of-type(1)]/slider1:peer-checked/slider1:opacity-100 peer-[&_label:nth-of-type(1)]/slider1:peer-checked/slider1:w-10 peer-[&_label:nth-of-type(2)]/slider2:peer-checked/slider2:opacity-100 peer-[&_label:nth-of-type(2)]/slider2:peer-checked/slider2:w-10 peer-[&_label:nth-of-type(3)]/slider3:peer-checked/slider3:opacity-100 peer-[&_label:nth-of-type(3)]/slider3:peer-checked/slider3:w-10"
  >
    <label
      class="block w-5 h-5 bg-gray-700 cursor-pointer opacity-50 z-10 transition-all duration-300 ease-in-out hover:scale-125 hover:opacity-100"
      for="slider1"
    >
    </label>
    <label
      class="block w-5 h-5 bg-gray-700 cursor-pointer opacity-50 z-10 transition-all duration-300 ease-in-out hover:scale-125 hover:opacity-100"
      for="slider2"
    >
    </label>
    <label
      class="block w-5 h-5 bg-gray-700 cursor-pointer opacity-50 z-10 transition-all duration-300 ease-in-out hover:scale-125 hover:opacity-100"
      for="slider3"
    >
    </label>
  </div>
</div>